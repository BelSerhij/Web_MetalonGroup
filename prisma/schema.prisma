generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION
  WAREHOUSE
}

enum EmployeeType {
  PRODUCTION
  SALES
}

enum CoilStatus {
  IN_STOCK
  IN_USE
  FINISHED
  WRITTEN_OFF
}

enum CoilPriceUnit {
  PER_KG
  PER_LINEAR_METER
  PER_SQUARE_METER
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PRODUCTION
  SALE
  RETURN
  WRITE_OFF
  ADJUSTMENT
  RESERVATION
  UNRESERVATION
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERPAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

// ============================================
// USERS
// ============================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true)
  orders       Order[]  @relation("OrderCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id              String       @id @default(uuid())
  name            String
  phone           String?
  email           String?
  employeeType    EmployeeType
  bonusPerMeter   Decimal      @default(0) @db.Decimal(12, 2)
  isActive         Boolean      @default(true)
  salesOrders      Order[]      @relation("SalesManager")
  shiftAssignments ProductionShiftEmployee[]
  payments         EmployeePayment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([employeeType, isActive])
}

// ============================================
// SUPPLIERS
// ============================================

model Supplier {
  id          String      @id @default(uuid())
  name        String
  phone       String?
  email       String?
  companyName String?
  edrpou      String?
  address     String?
  note        String?
  coils       MetalCoil[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
  @@index([companyName])
  @@index([edrpou])
}

// ============================================
// WAREHOUSES
// ============================================

model Warehouse {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  address        String?
  isActive       Boolean         @default(true)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  description    String?
  category       String
  image          String
  unit           String
  isVisible      Boolean          @default(true)
  usefulWidth    Decimal          @db.Decimal(10, 3)
  fullWidth      Decimal          @db.Decimal(10, 3)
  variants       ProductVariant[]
  productions    Production[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category])
}

// ============================================
// PRODUCT VARIANTS
// ============================================

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  thickness      Decimal         @db.Decimal(5, 3)
  color          String
  coating        String
  paintingType   String
  metalBrand     String
  zincContent    Int
  price          Decimal         @db.Decimal(12, 2)
  imageUrl       String?
  purchasePrice  Decimal?        @db.Decimal(12, 2)
  markupType     String          @default("PERCENT")
  markupValue    Decimal?        @db.Decimal(8, 2)
  isVisible      Boolean         @default(true)
  inStock        Boolean         @default(true)
  sourceCoilId   String?         @unique
  sourceCoil     MetalCoil?      @relation(fields: [sourceCoilId], references: [id], onDelete: SetNull)
  productions    Production[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
  @@index([color])
  @@index([thickness])
  @@index([metalBrand])
  @@index([productId, color, thickness, metalBrand])
}

// ============================================
// METAL COILS
// ============================================

model MetalCoil {
  id         String    @id @default(uuid())
  code       String    @unique
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  color              String
  thickness          Decimal      @db.Decimal(5, 3)
  coating            String
  paintingType       String
  metalBrand         String
  zincContent        Int
  width              Decimal      @db.Decimal(10, 3)
  initialWeight      Decimal      @db.Decimal(12, 3)
  currentWeight      Decimal      @db.Decimal(12, 3)
  initialLength      Decimal?     @db.Decimal(12, 3)
  currentLength      Decimal?     @db.Decimal(12, 3)
  purchasePrice      Decimal      @db.Decimal(14, 2)
  purchasePricePerKg Decimal?     @db.Decimal(12, 2)
  purchaseUnit       CoilPriceUnit @default(PER_KG)
  purchaseUnitPrice  Decimal?      @db.Decimal(12, 2)
  productSlug        String?
  pricedVariant      ProductVariant?
  status             CoilStatus   @default(IN_STOCK)
  receivedAt         DateTime     @default(now())
  productions        Production[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([color])
  @@index([thickness])
  @@index([metalBrand])
  @@index([status])
  @@index([supplierId])
}

model PricingSettings {
  id                          String  @id @default("default")
  manufacturingMarkupPercent Decimal @default(20) @db.Decimal(5, 2)
  partnerMarkupPercent       Decimal @default(18) @db.Decimal(5, 2)
  updatedAt                   DateTime @updatedAt
}

model MaterialRate {
  id            String   @id @default(uuid())
  metalBrand    String
  thickness     Decimal  @db.Decimal(5, 3)
  coating       String
  paintingType  String
  pricePerMeter Decimal  @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  @@unique([metalBrand, thickness, coating, paintingType])
  @@index([metalBrand, thickness])
}

// ============================================
// PRODUCTION
// ============================================

model Production {
  id        String          @id @default(uuid())
  orderId   String?
  order     Order? @relation(fields: [orderId], references: [id])
  coilId    String
  coil      MetalCoil       @relation(fields: [coilId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  shiftId   String?
  shift     ProductionShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status           ProductionStatus @default(PLANNED)
  usedWeight       Decimal?         @db.Decimal(12, 3)
  usedLength       Decimal?         @db.Decimal(12, 3)
  producedQuantity Decimal          @db.Decimal(12, 3)
  wasteQuantity    Decimal          @default(0) @db.Decimal(12, 3)
  costPrice        Decimal?         @db.Decimal(14, 2)
  productionDate   DateTime         @default(now())
  note             String?

  stockMovements   StockMovement[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId])
  @@index([coilId])
  @@index([productId])
  @@index([variantId])
  @@index([productionDate])
  @@index([status])
  @@index([shiftId])
}

model ProductionShift {
  id        String   @id @default(uuid())
  workDate  DateTime @unique @db.Date
  note      String?
  plans     ProductionPlan[]
  employees ProductionShiftEmployee[]
  production Production[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
}

model ProductionShiftEmployee {
  id         String          @id @default(uuid())
  shiftId    String
  shift      ProductionShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bonusPerMeter Decimal      @default(0) @db.Decimal(12, 2)
  createdAt  DateTime        @default(now())

  @@unique([shiftId, employeeId])
  @@index([employeeId])
}

model ProductionPlan {
  id            String          @id @default(uuid())
  shiftId       String
  shift         ProductionShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  orderId       String          @unique
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plannedMeters Decimal         @db.Decimal(12, 3)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([shiftId])
}

model EmployeePayment {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  paidAt     DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, paidAt])
}

// ============================================
// STOCK MOVEMENTS
// ============================================

model StockMovement {
  id          String     @id @default(uuid())
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity     Decimal           @db.Decimal(12, 3)
  type         StockMovementType
  productionId String?
  production   Production?       @relation(fields: [productionId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  note      String?
  createdAt DateTime @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([productionId])
  @@index([orderId])
  @@index([createdAt])
  @@index([warehouseId, variantId])
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  companyName String?
  edrpou      String?
  address     String?
  note        String?
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([companyName])
  @@index([edrpou])
}

// ============================================
// ORDERS
// ============================================

model Order {
  id         String    @id @default(uuid())
  number     String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdById String?

  createdBy User? @relation("OrderCreatedBy", fields: [createdById], references: [id])
  salesManagerId String?
  salesManager   Employee? @relation("SalesManager", fields: [salesManagerId], references: [id], onDelete: SetNull)
  salesBonusPerMeter Decimal? @db.Decimal(12, 2)

  status         OrderStatus     @default(NEW)
  paymentStatus  PaymentStatus   @default(PENDING)
  totalAmount    Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal         @default(0) @db.Decimal(14, 2)
  totalCostPrice Decimal?        @db.Decimal(14, 2)
  deliveryService String?
  deliveryAddress String?
  trackingNumber String?
  note           String?
  items          OrderItem[]
  manualItems    OrderManualItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  productions Production[]
  productionPlan ProductionPlan?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([salesManagerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ============================================
// ORDER ITEMS
// ============================================

model OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Decimal        @db.Decimal(12, 3)
  // Довжина виробу
  length     Decimal?       @db.Decimal(10, 3)
  // Ширина виробу або додатковий розмір
  width      Decimal?       @db.Decimal(10, 3)
  parameters Json?
  price      Decimal        @db.Decimal(14, 2)
  costPrice  Decimal?       @db.Decimal(14, 2)
  total      Decimal        @db.Decimal(14, 2)
  createdAt  DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderManualItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title          String
  unit           String   @default("шт.")
  quantity       Decimal  @db.Decimal(12, 3)
  length         Decimal? @db.Decimal(10, 3)
  purchasePrice  Decimal? @db.Decimal(14, 2)
  price          Decimal  @db.Decimal(14, 2)
  total          Decimal  @db.Decimal(14, 2)
  purchaseStatus String   @default("NEEDS_ORDER")
  note           String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([purchaseStatus])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  note      String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([paidAt])
}

// ============================================
// FENCE POSTS
// ============================================

model FencePost {
  id        String   @id @default(cuid())
  title     String
  size      String
  thickness Decimal  @db.Decimal(5, 3)
  length    Decimal  @db.Decimal(10, 3)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FENCE LAGS
// ============================================

model FenceLag {
  id        String   @id @default(cuid())
  title     String
  size      String
  thickness Decimal  @db.Decimal(5, 3)
  length    Decimal  @db.Decimal(10, 3)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FENCE SCREWS
// ============================================

model FenceScrew {
  id        String   @id @default(cuid())
  title     String
  size      String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
