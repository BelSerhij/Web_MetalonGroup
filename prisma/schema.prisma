generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION
  WAREHOUSE
}

enum CoilStatus {
  IN_STOCK
  IN_USE
  FINISHED
  WRITTEN_OFF
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PRODUCTION
  SALE
  RETURN
  WRITE_OFF
  ADJUSTMENT
  RESERVATION
  UNRESERVATION
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

// ============================================
// USERS
// ============================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true)
  orders       Order[]  @relation("OrderCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// SUPPLIERS
// ============================================

model Supplier {
  id          String      @id @default(uuid())
  name        String
  phone       String?
  email       String?
  companyName String?
  edrpou      String?
  address     String?
  note        String?
  coils       MetalCoil[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
  @@index([companyName])
  @@index([edrpou])
}

// ============================================
// WAREHOUSES
// ============================================

model Warehouse {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  address        String?
  isActive       Boolean         @default(true)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  description    String?
  category       String
  image          String
  unit           String
  usefulWidth    Decimal          @db.Decimal(10, 3)
  fullWidth      Decimal          @db.Decimal(10, 3)
  variants       ProductVariant[]
  productions    Production[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category])
}

// ============================================
// PRODUCT VARIANTS
// ============================================

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  thickness      Decimal         @db.Decimal(5, 3)
  color          String
  coating        String
  paintingType   String
  metalBrand     String
  zincContent    Int
  price          Decimal         @db.Decimal(12, 2)
  inStock        Boolean         @default(true)
  productions    Production[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
  @@index([color])
  @@index([thickness])
  @@index([metalBrand])
  @@index([productId, color, thickness, metalBrand])
}

// ============================================
// METAL COILS
// ============================================

model MetalCoil {
  id         String    @id @default(uuid())
  code       String    @unique
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  color              String
  thickness          Decimal      @db.Decimal(5, 3)
  coating            String
  paintingType       String
  metalBrand         String
  zincContent        Int
  width              Decimal      @db.Decimal(10, 3)
  initialWeight      Decimal      @db.Decimal(12, 3)
  currentWeight      Decimal      @db.Decimal(12, 3)
  initialLength      Decimal?     @db.Decimal(12, 3)
  currentLength      Decimal?     @db.Decimal(12, 3)
  purchasePrice      Decimal      @db.Decimal(14, 2)
  purchasePricePerKg Decimal?     @db.Decimal(12, 2)
  status             CoilStatus   @default(IN_STOCK)
  receivedAt         DateTime     @default(now())
  productions        Production[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([color])
  @@index([thickness])
  @@index([metalBrand])
  @@index([status])
  @@index([supplierId])
}

// ============================================
// PRODUCTION
// ============================================

model Production {
  id        String          @id @default(uuid())
  orderId   String?
  order     Order? @relation(fields: [orderId], references: [id])
  coilId    String
  coil      MetalCoil       @relation(fields: [coilId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  status           ProductionStatus @default(PLANNED)
  usedWeight       Decimal?         @db.Decimal(12, 3)
  usedLength       Decimal?         @db.Decimal(12, 3)
  producedQuantity Decimal          @db.Decimal(12, 3)
  wasteQuantity    Decimal          @default(0) @db.Decimal(12, 3)
  costPrice        Decimal?         @db.Decimal(14, 2)
  productionDate   DateTime         @default(now())
  note             String?

  stockMovements   StockMovement[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId])
  @@index([coilId])
  @@index([productId])
  @@index([variantId])
  @@index([productionDate])
  @@index([status])
}

// ============================================
// STOCK MOVEMENTS
// ============================================

model StockMovement {
  id          String     @id @default(uuid())
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity     Decimal           @db.Decimal(12, 3)
  type         StockMovementType
  productionId String?
  production   Production?       @relation(fields: [productionId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  note      String?
  createdAt DateTime @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([productionId])
  @@index([orderId])
  @@index([createdAt])
  @@index([warehouseId, variantId])
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  companyName String?
  edrpou      String?
  address     String?
  note        String?
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([companyName])
  @@index([edrpou])
}

// ============================================
// ORDERS
// ============================================

model Order {
  id         String    @id @default(uuid())
  number     String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdById String?

  createdBy User? @relation("OrderCreatedBy", fields: [createdById], references: [id])

  status         OrderStatus     @default(NEW)
  paymentStatus  PaymentStatus   @default(PENDING)
  totalAmount    Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal         @default(0) @db.Decimal(14, 2)
  totalCostPrice Decimal?        @db.Decimal(14, 2)
  note           String?
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  productions Production[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ============================================
// ORDER ITEMS
// ============================================

model OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Decimal        @db.Decimal(12, 3)
  // Довжина виробу
  length     Decimal?       @db.Decimal(10, 3)
  // Ширина виробу або додатковий розмір
  width      Decimal?       @db.Decimal(10, 3)
  parameters Json?
  price      Decimal        @db.Decimal(14, 2)
  costPrice  Decimal?       @db.Decimal(14, 2)
  total      Decimal        @db.Decimal(14, 2)
  createdAt  DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  note      String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([paidAt])
}

// ============================================
// FENCE POSTS
// ============================================

model FencePost {
  id        String   @id @default(cuid())
  title     String
  size      String
  thickness Decimal  @db.Decimal(5, 3)
  length    Decimal  @db.Decimal(10, 3)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FENCE LAGS
// ============================================

model FenceLag {
  id        String   @id @default(cuid())
  title     String
  size      String
  thickness Decimal  @db.Decimal(5, 3)
  length    Decimal  @db.Decimal(10, 3)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FENCE SCREWS
// ============================================

model FenceScrew {
  id        String   @id @default(cuid())
  title     String
  size      String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
